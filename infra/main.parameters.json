{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "swaLocation": {
      "value": "${AZURE_SWA_LOCATION=eastus2}"
    },
    "openAiLocation": {
      "value": "${AZURE_OPENAI_LOCATION=eastus2}"
    },
    "extraAllowedOrigins": {
      "value": "${EXTRA_ALLOWED_ORIGINS=http://localhost:5173}"
    },
    "appAccessKey": {
      "value": "${APP_ACCESS_KEY}"
    }
  }
}

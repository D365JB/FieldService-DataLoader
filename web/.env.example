# Multi-tenant App Reg (organizations) — required for sign-in.
# To create one:
#   az ad app create --display-name "FS Data Studio" --sign-in-audience AzureADMultipleOrgs \
#     --web-redirect-uris http://localhost:5173 https://<your-swa>.azurestaticapps.net
# Then grab the appId and paste below.
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/organizations

# AOAI proxy (set to our Function App once deployed; in dev points at local Functions)
VITE_AOAI_PROXY_URL=/api/generateContent
